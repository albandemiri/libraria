# For running the backend directly on the host (npm run dev) against the
# Postgres container. When running the backend *in* Compose, the values in
# docker-compose.yml apply instead and POSTGRES_HOST is `db`.

NODE_ENV=development
PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=libraria_user
POSTGRES_PASSWORD=libraria_password
POSTGRES_DB=libraria

# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret
JWT_EXPIRES_IN=7d

# bcrypt cost factor (10-15).
BCRYPT_ROUNDS=12

# Payments. `simulated` completes checkout without a payment provider and is
# for development only; the backend refuses to start with it in production.
# `disabled` rejects checkout. Default: simulated (dev/test), disabled (prod).
PAYMENTS_MODE=simulated

# Logging: debug | info | warn | error | silent. Logs are JSON lines.
LOG_LEVEL=info
