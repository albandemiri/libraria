# For running the backend directly on the host (npm run dev) against the
# Postgres container. When running the backend *in* Compose, the values in
# docker-compose.yml apply instead and POSTGRES_HOST is `db`.

NODE_ENV=development
PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=libraria_user
POSTGRES_PASSWORD=libraria_password
POSTGRES_DB=libraria

# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret
JWT_EXPIRES_IN=7d

# bcrypt cost factor (10-15).
BCRYPT_ROUNDS=12

# Publisher portal (cookie login).
# Comma-separated exact origins allowed to call the API with cookies. Empty
# means no cross-origin access (dev uses the Vite proxy, which is same-origin).
# Production example: https://portal.libraria.example
CORS_ORIGINS=
# Portal login lifetime without / with "Remember me".
PORTAL_SESSION_HOURS=12
PORTAL_REMEMBER_DAYS=30

# Payments: paddle | simulated | disabled.
#   simulated: no provider; payment is confirmed by signed sandbox webhooks.
#              Development only; the backend refuses to start with it in
#              production.
#   paddle:    Paddle Billing checkout. See README "Payments" for setup.
#   disabled:  checkout is rejected.
# Default: simulated (dev/test), disabled (production).
PAYMENTS_MODE=simulated

# Paddle (only when PAYMENTS_MODE=paddle). Never commit real values.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Logging: debug | info | warn | error | silent. Logs are JSON lines.
LOG_LEVEL=info

# Book-asset DRM. The defaults below are development-only and published in the
# repo; the backend refuses to start in production with them.
# KMS_PROVIDER=local keeps the key-encryption key in the environment and is
# also refused in production (a managed KMS adapter is required there).
KMS_PROVIDER=local
# Base64 of exactly 32 random bytes, with no trailing newline or whitespace. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DRM_LOCAL_KEK=OhI9j5jZV6qL59ZQVGRsAUHlduS3kmxEGrq9uvASu3s=
# Ed25519 PKCS#8 PEM (use literal \n for newlines). Generate with:
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}).trim().split(String.fromCharCode(10)).join(String.fromCharCode(92)+'n'))"
LICENCE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIGGhwCl2iLTohcCtEDBIjY/ZIsvpGiqmV3CFH4AuKxkg\n-----END PRIVATE KEY-----\n"
# Days a device licence is valid before the app must renew it.
LICENCE_DAYS=30

# Object storage backend. Only `local` exists; it is refused when NODE_ENV=production.
STORAGE_PROVIDER=local
# Where the local object storage keeps uploaded and encrypted assets.
ASSET_STORAGE_DIR=./var/asset-storage
# Malware scanner: none (development only, refused in production) or clamav.
SCANNER=none
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Milliseconds to wait for clamd while scanning (a 100 MB file needs far more than 10 s).
CLAMAV_TIMEOUT_MS=120000

# Hard limit of one EPUB upload, enforced while the body streams in (default 100 MB).
ASSET_MAX_UPLOAD_BYTES=104857600
# Wall-clock limit of one EPUB validation. A job lock older than 3x this is reclaimed.
ASSET_PROCESSING_TIMEOUT_MS=60000
