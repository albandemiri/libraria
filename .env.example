# Copy to .env and adjust. Compose falls back to these same defaults if absent.

# Database
POSTGRES_USER=libraria_user
POSTGRES_PASSWORD=libraria_password
POSTGRES_DB=libraria
POSTGRES_PORT=5432

# Backend
PORT=3000

# Auth. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production; must be at least 32 characters.
JWT_SECRET=dev-only-insecure-secret
JWT_EXPIRES_IN=7d

# Publisher portal (cookie login).
# Comma-separated exact origins allowed to call the API with cookies. Empty
# means no cross-origin access (dev uses the Vite proxy, which is same-origin).
# Production example: https://portal.libraria.example
CORS_ORIGINS=
# Portal login lifetime without / with "Remember me".
PORTAL_SESSION_HOURS=12
PORTAL_REMEMBER_DAYS=30

# Payments: paddle | simulated | disabled.
#   simulated: no provider; payment is confirmed by signed sandbox webhooks.
#              Development only; the backend refuses to start with it in
#              production.
#   paddle:    Paddle Billing checkout. See README "Payments" for setup.
#   disabled:  checkout is rejected.
# Default: simulated (dev/test), disabled (production).
PAYMENTS_MODE=simulated

# Paddle (only when PAYMENTS_MODE=paddle). Never commit real values.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Logging: debug | info | warn | error | silent. Logs are JSON lines.
LOG_LEVEL=info
