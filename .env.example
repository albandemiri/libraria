# Copy to .env and adjust. Compose falls back to these same defaults if absent.

# Database
POSTGRES_USER=libraria_user
POSTGRES_PASSWORD=libraria_password
POSTGRES_DB=libraria
POSTGRES_PORT=5432

# Backend
PORT=3000

# Auth. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production; must be at least 32 characters.
JWT_SECRET=dev-only-insecure-secret
JWT_EXPIRES_IN=7d
