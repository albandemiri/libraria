# Libraria reader website. Every value has a development default; copy to .env to override.

# Backend API origin, called server-side (no /api proxy). In Docker: http://backend:3000
API_URL=http://localhost:3000
# Signs the session cookie. The dev default is refused when NODE_ENV=production.
SESSION_SECRET=dev-only-web-session-secret
# This site's public origin (used for the same-origin check on form posts).
PUBLIC_ORIGIN=http://localhost:5174
# simulated (dev only) or paddle.
PAYMENTS_MODE=simulated
# Paddle.js client-side token, only needed when PAYMENTS_MODE=paddle.
PADDLE_CLIENT_TOKEN=
PADDLE_ENVIRONMENT=sandbox
# Publisher portal, linked from the footer.
PORTAL_URL=http://localhost:5173
