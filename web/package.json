{
  "name": "libraria-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "design:build": "npm --prefix ../design run build",
    "predev": "npm run design:build",
    "dev": "react-router dev",
    "prebuild": "npm run design:build",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
