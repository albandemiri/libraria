    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@react-router/node": "7.18.5",
    "@react-router/serve": "7.18.5",
    "i18next": "^27.1.1",
    "isbot": "^5.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "7.18.5",
    "zod": "^4.4.3"
